# Copy to server/.env.local (gitignored). The browser never sees these.

# Claude vision for /look. Without it the hub returns 503 unless LOOK_MOCK=1.
ANTHROPIC_API_KEY=
# Optional model overrides (defaults: claude-haiku-4-5 for look/ask, claude-opus-5-5 for "more")
# LOOK_MODEL=claude-haiku-4-5
# DEEP_MODEL=claude-opus-5-5
# LOOK_MOCK=1

# Optional: ElevenLabs voice for every sentence (else the browser's own voice is used)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# HUB_PORT=8787
